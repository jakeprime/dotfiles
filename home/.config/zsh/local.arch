export LC_TIME="en_GB.UTF-8"
export MOZ_ENABLE_WAYLAND=1

export ANDROID_HOME=/home/jake/Android/Sdk
export ANDROID_SDK_ROOT=/home/jake/Android/Sdk
export MU4E_DIR=/usr/share/emacs/site-lisp/mu4e

export PATH="$HOME/.local/share/cask/bin:$PATH"

if [[ -d /home/linuxbrew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

keychain_dir=$XDG_STATE_HOME/keychain
if [[ -z $(keychain list --dir $keychain_dir) ]]; then
  keychain id_archibald --dir $keychain_dir
fi
. $keychain_dir/archibald-sh

alias H=Hyprland

# cleo
alias cl="cd ~/work/cleo/meetcleo"
alias clm="cd ~/work/cleo/mobile-app"

# prime translatrix
alias pt="cd ~/work/primetranslatrix/primetranslatrix-3"

ghostty_dir="${XDG_CONFIG_HOME}/ghostty"
if ! [[ -f "$ghostty_dir/local.ghostty" ]]; then
  ln -sf "${ghostty_dir}/arch.ghostty" "${ghostty_dir}/local.ghostty"
fi
